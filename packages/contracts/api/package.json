{
  "name": "@repo/api-contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./*": "./*.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun scripts/build.ts",
    "compile": "bun x cross-env COMPILE_MODE=true bun run build",
    "dev": "bun run build -- --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@orpc/contract": "catalog:orpc",
    "@orpc/shared": "catalog:orpc",
    "@repo/orpc-utils": "*",
    "@repo/auth": "*",
    "zod": "catalog:utils"
  },
  "peerDependencies": {
    "@orpc/contract": "catalog:orpc",
    "@orpc/shared": "catalog:orpc",
    "zod": "catalog:utils"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "chokidar": "catalog:build",
    "@repo-configs/typescript": "*",
    "typescript": "catalog:build",
    "eslint": "catalog:linting",
    "@repo-configs/eslint": "*",
    "@repo-configs/prettier": "*",
    "vitest": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing"
  }
}
